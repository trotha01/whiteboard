# Copy to `.env.local` and fill in from Supabase → Project Settings → API.
# Both are safe to expose in the browser bundle; row level security is the guard.
# Leave them unset to run the board in memory, with no persistence.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: point this deploy at a different board row (any UUID).
# VITE_BOARD_ID=9b60c1aa-1550-4754-81ef-0812db0cb5ca
